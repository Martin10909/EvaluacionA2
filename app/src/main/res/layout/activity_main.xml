<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorraizprincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Container for Fragments (fragment_container) -->
    <FrameLayout
        android:id="@+id/contenedorfragmento"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp" />

    <!-- Custom Bottom Navigation Bar with Action Items -->
    <include layout="@layout/layout_barra_acciones" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>