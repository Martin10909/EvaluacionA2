<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvbarranavegacionprincipal"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_gravity="bottom"
    android:elevation="8dp"
    android:translationZ="8dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/llcontenedornavegacionprincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/btnnavegacioninicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioninicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvetiquetanavegacioninicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_home"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Compras -->
        <LinearLayout
            android:id="@+id/btnnavegacioncompras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioncompras"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_purchases"
                android:src="@drawable/ic_nav_purchases"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvetiquetanavegacioncompras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_purchases"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Compartidos -->
        <LinearLayout
            android:id="@+id/btnnavegacioncompartidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioncompartidos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_shared"
                android:src="@drawable/ic_nav_shared"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvetiquetanavegacioncompartidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_shared"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Contactos -->
        <LinearLayout
            android:id="@+id/btnnavegacioncontactos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioncontactos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_contacts"
                android:src="@drawable/ic_nav_contacts"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvetiquetanavegacioncontactos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_contacts"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Mapa -->
        <LinearLayout
            android:id="@+id/btnnavegacionmapa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacionmapa"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_map"
                android:src="@drawable/ic_nav_map"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvetiquetanavegacionmapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_map"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>