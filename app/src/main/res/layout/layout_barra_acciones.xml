<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvbarranavegacionprincipal"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_gravity="bottom"
    android:elevation="16dp"
    android:translationZ="16dp"
    app:cardBackgroundColor="#469048"
    app:cardCornerRadius="0dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:id="@+id/llcontenedornavegacionprincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/btnnavegacioninicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioninicio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_home"
                android:src="@android:drawable/ic_menu_today"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvetiquetanavegacioninicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Compras -->
        <LinearLayout
            android:id="@+id/btnnavegacioncompras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioncompras"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_purchases"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvetiquetanavegacioncompras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_purchases"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Compartidos -->
        <LinearLayout
            android:id="@+id/btnnavegacioncompartidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioncompartidos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_shared"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvetiquetanavegacioncompartidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_shared"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Contactos -->
        <LinearLayout
            android:id="@+id/btnnavegacioncontactos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacioncontactos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_contacts"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvetiquetanavegacioncontactos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_contacts"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mapa -->
        <LinearLayout
            android:id="@+id/btnnavegacionmapa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgicononavegacionmapa"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/nav_map"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvetiquetanavegacionmapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_map"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>