<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollnuevogastocompartido"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    tools:context=".AddSharedExpenseDialogFragment">

    <LinearLayout
        android:id="@+id/llcontenedorraizdialogocompartido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvtitulodividirgasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shared_dialog_title"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvsubtitulodividirgasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/shared_dialog_subtitle"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Concept Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilcontenedorconcepto"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/concept_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etconceptoservicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Total Amount Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilcontenedormontototal"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/total_amount_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etmontototaldividir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilcontenedorcategoriagasto"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/category_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etcategoriagasto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Who Paid Selection -->
        <TextView
            android:id="@+id/tvpreguntaquienpago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/who_paid_label"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sppagador"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:drawable/btn_dropdown" />

        <!-- Participants Selection -->
        <TextView
            android:id="@+id/tvtituloseleccioncontactos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/select_contacts_label"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llseleccionparticipantes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/chkcontacto1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/sample_contact_1"
                android:textColor="#212121" />

        </LinearLayout>

        <!-- Split Preview CardView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvtarjetavistapreviadivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvvistapreviadivision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/split_preview_default"
                android:textColor="#2E7D32"
                android:textSize="12sp" />

        </androidx.cardview.widget.CardView>

        <!-- GPS Panel CardView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvpanelgpscompartido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:id="@+id/llcontenedorgpscompartido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/llcabeceragpscompartido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgiconogpscompartido"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/gps_title"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#2E7D32" />

                    <TextView
                        android:id="@+id/tvtituloubicacioncompartido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/gps_title"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btncapturargpscompartido"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capture_gps_btn"
                        android:textColor="#2E7D32" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvcoordenadasgpscompartido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/default_gps_coords"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etnombrelugarcompartido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/place_name_hint"
                    android:inputType="text"
                    android:textSize="13sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/llaccionesdialogocompartido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btncancelargastocompartido"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_btn"
                android:textColor="#757575" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnguardargastocompartido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:backgroundTint="#2E7D32"
                android:text="@string/save_btn"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>