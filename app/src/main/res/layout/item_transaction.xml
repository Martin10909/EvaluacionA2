<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvitemtransaccion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/llcontenedorprincipaltransaccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/llfilasuperiortransaccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgiconotransaccion"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#E8F5E9"
                android:contentDescription="@string/transactions_header"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#2E7D32" />

            <LinearLayout
                android:id="@+id/lltextossuperiorestransaccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvcategoriatransaccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Alimentación" />

                <TextView
                    android:id="@+id/tvnotatransaccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    tools:text="Almuerzo de trabajo" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvmontotransaccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C62828"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="-$12.50" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llfilainferiortransaccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvcuentatransaccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="11sp"
                tools:text="Cuenta Principal" />

            <TextView
                android:id="@+id/tvubicaciontransaccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#757575"
                android:textSize="11sp"
                tools:text="Ubicación: Restobar" />

            <TextView
                android:id="@+id/tvetiquetatipotransaccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#C62828"
                android:textSize="11sp"
                tools:text="Gasto" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>